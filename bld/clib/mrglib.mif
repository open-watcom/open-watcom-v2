tree_depth = 5

!include $(clib_dir)/master.mif

!include ../../objects.mif
!include ../libs.mif

.c : ../../c

all : $(libname).lib .SYMBOLIC
    @%null

$(libname).lib : $(objs) $(libs) $(__MAKEFILES__)
    $(noecho)%create $^&.lbc
    @for %i in ($(libs)) do @%append $^&.lbc +%i
    @for %i in ($(objs)) do @%append $^&.lbc +%i
    @rm -f export.tmp
    @rm -f export.gdf
!ifeq linkage dynamic
    @%make echo_lib
    $(librarian) $(clib_lib_flags) -z=export.tmp $@ @$^&.lbc
    @%make echo_awk
    $(noecho)awk -f $(build_dir)/export.awk export.tmp > export.gdf
!else	# linkage static
    @%make echo_lib
    $(librarian) $(clib_lib_flags) -z $@ @$^&.lbc
!endif

!include ../../deps.mif

!include $(clib_dir)/clean.mif
