# DOS/32A Extender redistributable binaries component of install manifest

[ DEFAULT dir="binw" rel="." cond="dostarg" where="c jc f77 jf77" ]
type="e"    usr="dos32a.exe"
type="s"    usr="license.d32"
type="s"    usr="readme.d32"
type="e"    usr="sb.exe"
type="e"    usr="sc.exe"
type="e"    usr="sd.exe"
type="e"    usr="ss.exe"
type="e"    usr="stub32a.exe"
type="e"    usr="stub32c.exe"

[ DEFAULT cond="dostarg" type="e" where="c jc f77 jf77" descr="DOS/32A version report utility" ]
dir="binw"      usr="sver.exe"      cond+="doshost winhost |"
dir="binp"      usr="sver.exe"      cond+="os2host"
dir="binnt"     usr="sver.exe"      cond+="wnthost"
dir="binnt64"   usr="sver.exe"      cond+="wnt64host"                   keys="ntx64"
dir="axpnt"     usr="sver.exe"      cond+="alphahost"   where="ac"
dir="binl"      usr="sver"          cond+="lnxhost"
dir="binl64"    usr="sver"          cond+="lnx64host"                   keys="lx64"
