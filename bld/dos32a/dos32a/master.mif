tree_depth = 4

proj_name = dos32a

dos32a_autodepends = .AUTODEPEND

additional_clean = mzalign.exe

subdir_ext  = ext
subdir_stub = stub

additional_remove_subdirs = ext stub

!include cproj.mif

defrule_key = ext
extra_app_ext_flags = -I"$(dos32a_dir)/src/dos32a" -I"$(dos32a_dir)/src/dos32a/text"
!include defrule.mif

defrule_key = stub
extra_app_stub_flags = -I"$(dos32a_dir)/src/stub32a"
!include defrule.mif

!include deftarg.mif

#
# aflags
#
.asm : $(dos32a_dir)/src/dos32a;$(dos32a_dir)/src/stub32a

inc_dirs = -I"$(dos32a_dir)/src/sutils/misc"

extra_a_flags = -DEXEC_TYPE=0 -fpi87 -zld

# explicit rules
#################

all : dos32a.exe stub32a.exe stub32c.exe .SYMBOLIC

$(subdir_ext)/dos32a.obj : $(dos32a_dir)/src/dos32a/text/include.asm $(dos32a_dir)/src/dos32a/text/client/misc.asm $(dos32a_dir)/src/dos32a/text/client/int21h.asm $(dos32a_dir)/src/dos32a/text/client/config.asm
$(subdir_ext)/kernel.obj : $(dos32a_dir)/src/dos32a/text/include.asm $(dos32a_dir)/src/dos32a/text/kernel/init.asm

#
# DOS32A.EXE (linked via exetarg.mif to .tmp, then aligned to 512-byte MZ header)
#
exetarg_prebuild_objs = $(subdir_ext)
exetarg_objs = $(subdir_ext)/dos32a.obj $(subdir_ext)/kernel.obj
exetarg_name = dos32a
exetarg_ext  = .tmp
exetarg_opts = op fullheader, packcode=0, packdata=0
!include exetarg.mif
!undef exetarg_ext

dos32a.exe : ./mzalign.exe dos32a.tmp
    @%make echo_execute
    $(noecho)$[@ $]@ $@ --pad-relocs 0x007E

#
# STUB32A.EXE
#
exetarg_prebuild_objs = $(subdir_stub)
exetarg_objs = $(subdir_stub)/stub32a.obj
exetarg_name = stub32a
exetarg_opts = op fullheader
!include exetarg.mif

#
# STUB32C.EXE
#
exetarg_prebuild_objs = $(subdir_stub)
exetarg_objs = $(subdir_stub)/stub32c.obj
exetarg_name = stub32c
exetarg_opts = op fullheader
!include exetarg.mif

./mzalign.exe : $(dos32a_dir)/src/sutils/mzalign/mzalign.c
    @%make echo_bldccl
    $(bld_ccl) $(ppflags_common) $(ppflags_autodep) $(bld_ppflags_sys) $(bld_cppflags) $[@ $(bld_cclflags) $(bld_ldflags)

$(additional_remove_subdirs) :
    mkdir $@
