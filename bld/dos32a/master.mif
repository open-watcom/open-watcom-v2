proj_name = dos32a

dos32a_autodepends = .AUTODEPEND

additional_clean = *.stb *.map mzalign.exe

!include cproj.mif
!include defrule.mif
!include deftarg.mif

d32_root = $(ow_root)/contrib/extender/dos32a
d32_src  = $(d32_root)/src
d32_inc  = -I"$(d32_root)/h32" -I"$(d32_src)/sutils/misc"

wasm_16_flags = -bt=dos -fpi87 -wx -we -zld -zq -dEXEC_TYPE=0 -I"$(d32_src)/sutils/misc" -I"$(d32_src)/dos32a" -I"$(d32_src)/dos32a/text"
wasm_32_flags = -bt=dos -3p -mf -wx -we -zld -zq -I"$(d32_src)/sutils/misc"
wcc386_flags  = -zq -oneatx -ohirbk -ol+ -ei -zp16 -6 -fp6 -fpi87 -bt=dos -mf $(d32_inc)

all : dos32a.exe dos32a.stb dos32a_stock.exe stub32a.exe stub32c.exe sb.exe ss.exe sc.exe sd.exe sver.exe .SYMBOLIC

./mzalign.exe : $(d32_src)/sutils/mzalign/mzalign.c
    @%make echo_bldccl
    $(bld_ccl) $(ppflags_common) $(bld_ppflags_sys) $(bld_cppflags) $[@ $(bld_cclflags) $(bld_ldflags)

kernel.obj : $(d32_src)/dos32a/kernel.asm
    $(as) $(wasm_16_flags) -dDOS_LEGACY_125_20=1 -dDOS32A_BOUND_STUB=0 -fo=$@ $[@

dos32a.obj : $(d32_src)/dos32a/dos32a.asm
    $(as) $(wasm_16_flags) -dDOS_LEGACY_125_20=1 -dDOS32A_BOUND_STUB=0 -fo=$@ $[@

dos32a_stb.obj : $(d32_src)/dos32a/dos32a.asm
    $(as) $(wasm_16_flags) -dDOS_LEGACY_125_20=1 -dDOS32A_BOUND_STUB=1 -fo=$@ $[@

kernel_stock.obj : $(d32_src)/dos32a/kernel.asm
    $(as) $(wasm_16_flags) -dDOS_LEGACY_125_20=0 -dDOS32A_BOUND_STUB=0 -fo=$@ $[@

dos32a_stock.obj : $(d32_src)/dos32a/dos32a.asm
    $(as) $(wasm_16_flags) -dDOS_LEGACY_125_20=0 -dDOS32A_BOUND_STUB=0 -fo=$@ $[@

dos32a.exe : ./mzalign.exe dos32a.obj kernel.obj
    $(linker) system dos op q, fullheader, packcode=0, packdata=0 name $@ file dos32a.obj, kernel.obj
    ./mzalign.exe $@ $@ --pad-relocs 0x007E

dos32a.stb : ./mzalign.exe dos32a_stb.obj kernel.obj
    $(linker) system dos op q, fullheader, packcode=0, packdata=0 name $@ file dos32a_stb.obj, kernel.obj
    ./mzalign.exe $@ $@ --pad-relocs 0x007E

dos32a_stock.exe : ./mzalign.exe dos32a_stock.obj kernel_stock.obj
    $(linker) system dos op q, fullheader, packcode=0, packdata=0 name $@ file dos32a_stock.obj, kernel_stock.obj
    ./mzalign.exe $@ $@ --pad-relocs 0x007E

stub32a.exe : $(d32_src)/stub32a/stub32a.asm
    $(as) -bt=dos -wx -we -zld -zq -dEXEC_TYPE=0 -I"$(d32_src)/sutils/misc" -fo=stub32a.obj $[@
    $(linker) system dos op q, fullheader name $@ file stub32a.obj

stub32c.exe : $(d32_src)/stub32a/stub32c.asm
    $(as) -bt=dos -wx -we -zld -zq -dEXEC_TYPE=0 -I"$(d32_src)/sutils/misc" -fo=stub32c.obj $[@
    $(linker) system dos op q, fullheader name $@ file stub32c.obj

sb.exe : dos32a.stb $(d32_src)/sb/sbind.asm $(d32_src)/sb/main.c
    $(as) $(wasm_32_flags) -fo=sbind.obj $(d32_src)/sb/sbind.asm
    $(cc_386) $(wcc386_flags) -I"$(d32_src)/sb" -fo=sb_main.obj $(d32_src)/sb/main.c
    $(linker) system dos32a op q, stub=dos32a.stb, stack=65536 name $@ file sbind.obj, sb_main.obj

ss.exe : dos32a.stb $(d32_src)/ss/setup.asm $(d32_src)/ss/main.c
    $(as) $(wasm_32_flags) -fo=setup.obj $(d32_src)/ss/setup.asm
    $(cc_386) $(wcc386_flags) -I"$(d32_src)/ss" -fo=ss_main.obj $(d32_src)/ss/main.c
    $(linker) system dos32a op q, stub=dos32a.stb, stack=65536 name $@ file setup.obj, ss_main.obj

sc.exe : dos32a.stb $(d32_src)/sc/scomp.asm $(d32_src)/sc/sload.asm $(d32_src)/sc/encode.c $(d32_src)/sc/main.c
    $(as) $(wasm_32_flags) -fo=scomp.obj $(d32_src)/sc/scomp.asm
    $(as) $(wasm_32_flags) -fo=sload.obj $(d32_src)/sc/sload.asm
    $(cc_386) $(wcc386_flags) -I"$(d32_src)/sc" -fo=sc_encode.obj $(d32_src)/sc/encode.c
    $(cc_386) $(wcc386_flags) -I"$(d32_src)/sc" -fo=sc_main.obj $(d32_src)/sc/main.c
    $(linker) system dos32a op q, stub=dos32a.stb, stack=65536 name $@ file scomp.obj, sload.obj, sc_encode.obj, sc_main.obj

sd.exe : dos32a.stb $(d32_src)/sd/sd.asm
    $(as) -bt=dos -4p -mf -fpi87 -wx -we -zld -zq -dSVR=0 -I"$(d32_src)/sutils/misc" -I"$(d32_src)/sd" -fo=sd.obj $(d32_src)/sd/sd.asm
    $(linker) system dos32a op q, stub=dos32a.stb name $@ file sd.obj

sver.exe : ./mzalign.exe $(d32_src)/sutils/sver/main.c
    $(cc_i86) -zq -oneatx -bt=dos -ml $(d32_inc) -fo=sver.obj $(d32_src)/sutils/sver/main.c
    $(linker) system dos op q, fullheader name $@ file sver.obj
    ./mzalign.exe $@ $@
