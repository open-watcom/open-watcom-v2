    #define pick(c,e,j) (c + RLE_ENGLISH * MSG_LANG_SPACING), [ e ]
    RCINCLUDE "rc.msg"
    RCINCLUDE "usage.gh"
    #undef pick

    #define pick(c,e,j) (c + RLE_JAPANESE * MSG_LANG_SPACING), [ j ]
    RCINCLUDE "rc.msg"
    RCINCLUDE "usage.gh"
    #undef pick
#else
    #define pick(c,e,j) (c + RLE_ENGLISH * MSG_LANG_SPACING), [ e ]
    #include "rc.msg"
    #include "usage.gh"
    #undef pick

    #define pick(c,e,j) (c + RLE_JAPANESE * MSG_LANG_SPACING), [ j ]
    #include "rc.msg"
    #include "usage.gh"
    #undef pick
#endif
END

