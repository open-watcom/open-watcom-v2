    #define pick(c,e,j) (AUI_LITERAL_##c + RLE_JAPANESE * MSG_LANG_SPACING), [ j ]
    RCINCLUDE "aui.msg"
    #undef pick
#else
    #define pick(c,e,j) (AUI_LITERAL_##c + RLE_ENGLISH * MSG_LANG_SPACING), [ e ]
    #include "aui.msg"
    #undef pick

    #define pick(c,e,j) (AUI_LITERAL_##c + RLE_JAPANESE * MSG_LANG_SPACING), [ j ]
    #include "aui.msg"
    #undef pick
#endif
END

