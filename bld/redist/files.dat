# Redistributable binaries component of install manifest

[ DEFAULT dir="binw" rel="." cond="dostarg" where="c jc f77 jf77" ]
# DOS/4GW
type="s"    usr="dos4gw.doc"
type="e"    usr="dos4gw.exe"
type="e"    usr="pminfo.exe"
type="e"    usr="rminfo.exe"

# PMODE/W
type="s"    usr="pmodew.doc"
type="e"    usr="pmodew.exe"
type="s"    usr="pmodew.faq"
type="e"    usr="pmwbind.exe"
type="e"    usr="pmwlite.exe"
type="e"    usr="pmwsetup.exe"
type="e"    usr="pmwver.com"
