tree_depth = 5

proj_name = cpplib

additional_clean = *.gdf

!include $(cpplib_dir)/master.mif

!include $(cpplib_dir)/libs.mif

libs : .SYMBOLIC $(target_lib) $(target_lib_x)
    @%null

$(target_lib) : $(libs) $(__MAKEFILES__)
    $(noecho)%create $^&.lbc
    @for %i in ($(libs)) do @%append $^&.lbc +%i
    @rm -f export.tmp
    @rm -f export.gdf
!ifeq linkage dynamic
    @%make echo_lib
    $(librarian) $(plib_lib_flags) -z=export.tmp $@ @$^&.lbc
    @%make echo_awk
    $(noecho)awk -f $(build_dir)/export.awk export.tmp > export.gdf
!else	# linkage static
    @%make echo_lib
    $(librarian) $(plib_lib_flags) -z=export.tmp $@ @$^&.lbc
!endif

$(target_lib_x) : $(libsx) $(__MAKEFILES__)
    $(noecho)%create $^&.lbc
    @for %i in ($(libsx)) do @%append $^&.lbc +%i
    @rm -f exportx.tmp
    @rm -f exportx.gdf
!ifeq linkage dynamic
    @%make echo_lib
    $(librarian) $(plib_lib_flags) -z=exportx.tmp $@ @$^&.lbc
    @%make echo_awk
    $(noecho)awk -f $(build_dir)/export.awk exportx.tmp > exportx.gdf
!else	# linkage static
    @%make echo_lib
    $(librarian) $(plib_lib_flags) -z=exportx.tmp $@ @$^&.lbc
!endif
