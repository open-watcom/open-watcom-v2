tree_depth = 4

proj_name = grlib_fix

!ifeq host_os qnx
clibdir = $(clib_dir)/library/qnx.286/ms/clibs.lib
!else ifeq host_cpu i86
clibdir = $(clib_dir)/library/msdos.086/ms/clibs.lib
!else
clibdir = $(clib_dir)/library/msdos.386/ms_r/clib3r.lib
!endif

!include cproj.mif
!include deftarg.mif

graph_path = $(graphlib_dir)/$(host)
pgchart_path = $(graphlib_dir)/pgchart/$(host)

! ifdef __UNIX__
awk_wlib_cmd=-v host_cmd=:
! else
awk_wlib_cmd=-v host_cmd=*
! endif

!ifeq host_cpu i86

all: graph.lib graph2.lib

def_suffix =
change_segm = -l=_TEXT=GRAPH_TEXT
gliblist = $(graph_path)/graphi.lib $(graph_path)$(def_suffix)/special.lib $(pgchart_path)/chart.lib
gliblist2 = $(graph_path)/graphi2.lib $(graph_path)$(def_suffix)/special2.lib $(pgchart_path)/chart2.lib

!else ifeq host_os dos

all: graph.lib graph2.lib

def_suffix = r
change_segm =
gliblist = $(graph_path)s/graphi.lib $(graph_path)r/graphi.lib $(graph_path)$(def_suffix)/special.lib $(pgchart_path)r/chart.lib $(pgchart_path)s/chart.lib
gliblist2 = $(graph_path)s/graphi2.lib $(graph_path)r/graphi2.lib $(graph_path)$(def_suffix)/special2.lib $(pgchart_path)r/chart2.lib $(pgchart_path)s/chart2.lib

!else ifeq host_os qnx

all: graph3r.lib graph3s.lib graph23r.lib graph23s.lib

!else
!endif

graph3r.lib : $(graph_path)r/graphi.lib $(graph_path)r/special.lib $(pgchart_path)r/chart.lib $(__MAKEFILES__)
    @%make echo_lib
    $(librarian) -n $(libflags) $@ +$(graph_path)r/graphi.lib +$(graph_path)r/special.lib +$(pgchart_path)r/chart.lib

graph3s.lib : $(graph_path)s/graphi.lib $(graph_path)r/special.lib $(pgchart_path)s/chart.lib $(__MAKEFILES__)
    @%make echo_lib
    $(librarian) -n $(libflags) $@ +$(graph_path)s/graphi.lib +$(graph_path)r/special.lib +$(pgchart_path)s/chart.lib

graph23r.lib : $(graph_path)r/graphi2.lib $(graph_path)r/special.lib $(pgchart_path)r/chart2.lib $(__MAKEFILES__)
    @%make echo_lib
    $(librarian) -n $(libflags) $@ +$(graph_path)r/graphi2.lib +$(graph_path)r/special.lib +$(pgchart_path)r/chart2.lib

graph23s.lib : $(graph_path)r/graphi2.lib $(graph_path)r/special.lib $(pgchart_path)s/chart2.lib $(__MAKEFILES__)
    @%make echo_lib
    $(librarian) -n $(libflags) $@ +$(graph_path)s/graphi2.lib +$(graph_path)r/special.lib +$(pgchart_path)s/chart2.lib

graph.lib : $(clibdir) $(gliblist) $(__MAKEFILES__)
    @%create tmp.lbc
    @for %i in ($(gliblist)) do @%append tmp.lbc +%i
    @%make echo_lib
    $(librarian) -n $(libflags) tmp.lib @tmp.lbc
    @rm -f *.obj
  # find external references - and check for double precision usage
    $(noecho)objxref -e=../except tmp.lib >ref1.tmp
    $(noecho)sort -o ref.tmp ref1.tmp
    $(noecho)egrep "__FD" ref.tmp >fdchk.tmp
    $(noecho)diff fdchk.tmp ../fd.ok
    @if errorlevel 1 echo ERROR - double precision floating point used
  # find all modules in clib which are referenced from graph.lib
    $(noecho)objfind -i=ref.tmp $(clibdir) >modc.tmp
  # extract all modules from clib which are referenced from graph.lib
    $(noecho)*awk $(awk_wlib_cmd) -f ../fix1.awk -v OUTFILE=clibget.lbc modc.tmp
    $(librarian) -b $(clibdir) @clibget.lbc
  # get all public symbols in extracted modules from clib, fsmath and dummy
  # they will be renamed later to don't conflict with public symbols in clib
    $(noecho)objxdef *.obj $(graph_path)$(def_suffix)/fsmath.obj $(graph_path)$(def_suffix)/dummy.obj >stb.tmp
!ifeq host_cpu i86
  # extract all modules from graph.lib library
    $(librarian) -b -x=.obj tmp.lib
!else
  # extract all modules from graph.lib library, use alias for 8.3 format
    $(noecho)objlist tmp.lib >modg.tmp
    $(noecho)*awk $(awk_wlib_cmd) -f ../fix2.awk -v OUTFILE=extract.lbc modg.tmp
    $(librarian) -b tmp.lib @extract.lbc
!endif
  # modify modules as needed
  # add _GR to names of all symbols in extracted files and fsmath, dummy
  # 16-bit change _TEXT segment to GRAPH_TEXT
    $(noecho)objchg $(change_segm) -m=_GR* -s=stb.tmp *.obj
  # put all modules together into new library
    $(noecho)%create $^&.lbc
    @for %i in (*.obj) do @%append $^&.lbc +%i
    @%make echo_lib
    $(librarian) -n $(libflags) $@ @$^&.lbc

graph2.lib : $(clibdir) $(gliblist2) $(__MAKEFILES__)
    @%create tmp2.lbc
    @for %i in ($(gliblist2)) do @%append tmp2.lbc +%i
    @%make echo_lib
    $(librarian) -n $(libflags) tmp2.lib @tmp2.lbc
    @rm -f *.obj
  # find external references - and check for double precision usage
    $(noecho)objxref -e=../except tmp2.lib >ref21.tmp
    $(noecho)sort -o ref2.tmp ref21.tmp
    $(noecho)egrep "__FD" ref2.tmp >fdchk2.tmp
    $(noecho)diff fdchk2.tmp ../fd.ok
    @if errorlevel 1 echo ERROR - double precision floating point used
  # find all modules in clib which are referenced from graph.lib
    $(noecho)objfind -i=ref2.tmp $(clibdir) >modc2.tmp
  # extract all modules from clib which are referenced from graph.lib
    $(noecho)*awk $(awk_wlib_cmd) -f ../fix1.awk -v OUTFILE=clibget2.lbc modc2.tmp
    $(librarian) -b $(clibdir) @clibget2.lbc
  # get all public symbols in extracted modules from clib, fsmath and dummy
  # they will be renamed later to don't conflict with public symbols in clib
    $(noecho)objxdef *.obj $(graph_path)$(def_suffix)/fsmath.obj $(graph_path)$(def_suffix)/dummy.obj >stb2.tmp
!ifeq host_cpu i86
  # extract all modules from graph.lib library
    $(librarian) -b -x=.obj tmp2.lib
!else
  # extract all modules from graph.lib library, use alias for 8.3 format
    $(noecho)objlist tmp2.lib >modg2.tmp
    $(noecho)*awk $(awk_wlib_cmd) -f ../fix2.awk -v OUTFILE=extract2.lbc modg2.tmp
    $(librarian) -b tmp2.lib @extract2.lbc
!endif
  # modify modules as needed
  # add _GR to names of all symbols in extracted files and fsmath, dummy
  # 16-bit change _TEXT segment to GRAPH_TEXT
    $(noecho)objchg $(change_segm) -m=_GR* -s=stb2.tmp *.obj
  # put all modules together into new library
    $(noecho)%create $^&.lbc
    @for %i in (*.obj) do @%append $^&.lbc +%i
    @%make echo_lib
    $(librarian) -n $(libflags) $@ @$^&.lbc
